# TWOtails Environment Variables

# AI Provider (for smart fix suggestions)
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Virtual Memory Settings
VIRTUAL_MEMORY_MAX_SIZE=100
VIRTUAL_MEMORY_TIMEOUT=30000

# Scanner Settings
MAX_FILE_SIZE=1024
SCAN_IGNORE_DIRS=node_modules,dist,.git,coverage
SCAN_FILE_EXTENSIONS=.js,.jsx,.ts,.tsx,.py

# Output Settings
REPORT_FORMAT=table
REPORT_OUTPUT=stdout
