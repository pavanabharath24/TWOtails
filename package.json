{
  "name": "@pavana/twotails",
  "version": "3.0.0",
  "description": "AI code quality analyzer - 6 scanners, 1 truth, zero false positives. Detects broken connections, security vulnerabilities, database issues, and AI hallucinations.",
  "keywords": [
    "opencode-plugin",
    "twotails",
    "code-analysis",
    "ai-code",
    "security-scanner",
    "database-analyzer",
    "api-analyzer",
    "virtual-memory",
    "signal-tracing"
  ],
  "license": "MIT",
  "author": {
    "name": "Pavana",
    "url": "https://github.com/pavana"
  },
  "homepage": "https://github.com/pavana/TWOtails",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavana/TWOtails.git"
  },
  "bugs": {
    "url": "https://github.com/pavana/TWOtails/issues"
  },
  "main": "./.opencode/plugins/twotails.mjs",
  "bin": {
    "twotails": "./src/index.js"
  },
  "exports": {
    ".": "./.opencode/plugins/twotails.mjs",
    "./plugin": "./.opencode/plugins/twotails.mjs"
  },
  "files": [
    "AGENTS.md",
    "src/",
    "skills/",
    "hooks/",
    ".opencode/",
    ".cursor/",
    ".github/",
    "examples/",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/analyzer.test.js tests/integration.test.js",
    "test:virtual": "node --test tests/virtual-memory.test.js",
    "dev": "node --watch src/index.js",
    "scan": "node src/index.js scan",
    "security": "node src/index.js security",
    "database": "node src/index.js database",
    "api": "node src/index.js api",
    "ai-quality": "node src/index.js ai-quality",
    "env": "node src/index.js env",
    "connectivity": "node src/index.js connectivity",
    "test:ui": "node src/index.js test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "acorn": "^8.12.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "glob": "^10.4.0",
    "playwright": "^1.63.0"
  }
}
