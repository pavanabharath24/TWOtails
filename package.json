{
  "name": "@pavana/twotails",
  "version": "2.0.0",
  "description": "AI code connectivity analyzer - checks every line for correctness, detects database issues, API problems, security vulnerabilities, and AI hallucinations.",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "twotails",
    "code-analysis",
    "signal-tracing",
    "virtual-memory",
    "ai-code",
    "connection-checker",
    "security-scanner",
    "database-analyzer",
    "api-analyzer",
    "ai-quality"
  ],
  "license": "MIT",
  "author": {
    "name": "Pavana",
    "url": "https://github.com/pavana"
  },
  "homepage": "https://github.com/pavana/TWOtails",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavana/TWOtails.git"
  },
  "bugs": {
    "url": "https://github.com/pavana/TWOtails/issues"
  },
  "main": "./.opencode/plugins/twotails.mjs",
  "bin": {
    "twotails": "./src/index.js"
  },
  "exports": {
    ".": "./.opencode/plugins/twotails.mjs",
    "./plugin": "./.opencode/plugins/twotails.mjs"
  },
  "files": [
    "AGENTS.md",
    "hooks/",
    "skills/",
    "src/",
    ".opencode/",
    ".cursor/",
    ".github/",
    "scripts/",
    "assets/",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "test": "node --test tests/analyzer.test.js tests/integration.test.js",
    "test:virtual": "node --test tests/virtual-memory.test.js",
    "dev": "node --watch src/index.js",
    "scan": "node src/index.js scan",
    "trace": "node src/index.js trace",
    "report": "node src/index.js report",
    "security": "node src/index.js security",
    "database": "node src/index.js database",
    "api": "node src/index.js api",
    "ai-quality": "node src/index.js ai-quality",
    "env": "node src/index.js env",
    "test:virtual": "node src/index.js test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "acorn": "^8.12.0",
    "acorn-jsx": "^5.3.2",
    "acorn-walk": "^8.3.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^12.0.0",
    "glob": "^10.4.0",
    "playwright": "^1.63.0"
  }
}
